# ansible/roles/wyoming/templates/wyoming-piper.service.j2  v2
[Unit]
Description=Wyoming TTS (sherpa-onnx matcha-zh-baker)
After=network.target

[Service]
Type=simple
ExecStart={{ mediaplayer_home }}/wyoming/sherpa-tts/bin/python3 \
    {{ mediaplayer_home }}/wyoming/sherpa-tts/sherpa_tts_server.py \
    --model-dir {{ mediaplayer_home }}/wyoming/sherpa-tts/model
Restart=always
RestartSec=3
StandardOutput=journal
StandardError=journal
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=default.target

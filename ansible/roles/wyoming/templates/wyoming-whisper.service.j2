# ansible/roles/wyoming/templates/wyoming-whisper.service.j2  v2
[Unit]
Description=Wyoming STT (sherpa-onnx SenseVoice)
After=network.target

[Service]
Type=simple
ExecStart={{ mediaplayer_home }}/wyoming/sherpa-stt/bin/python3 \
    {{ mediaplayer_home }}/wyoming/sherpa-stt/sherpa_stt_server.py \
    --model-dir {{ mediaplayer_home }}/wyoming/sherpa-stt/model
Restart=always
RestartSec=3
StandardOutput=journal
StandardError=journal
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=default.target

#!/bin/bash
# 处理 Wyoming 协议的标准输入并转化为 UI 事件
python3 -c '
import sys, json, socket
try:
    raw = sys.stdin.read().strip()
    try:
        parsed = json.loads(raw)
        text = parsed.get("data", {}).get("text", "") if isinstance(parsed, dict) and "data" in parsed else (parsed.get("text", raw) if isinstance(parsed, dict) else raw)
    except Exception:
        text = raw
except Exception:
    text = ""

payload = json.dumps({"event": "transcript", "text": text}).encode("utf-8")
sock = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
sock.sendto(payload, ("127.0.0.1", 10701))
'

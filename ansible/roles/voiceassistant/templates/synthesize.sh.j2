#!/bin/bash
# 处理 Wyoming 协议的标准输入并转化为 UI 事件
python3 -c '
import sys, json, socket
try:
    raw = sys.stdin.readline().strip()
    print(f"[LVA Event] synthesize raw: {raw}", file=sys.stderr)
    try:
        parsed = json.loads(raw)
        text = parsed.get("data", {}).get("text", "") if isinstance(parsed, dict) and "data" in parsed else (parsed.get("text", raw) if isinstance(parsed, dict) else raw)
    except Exception as e:
        print(f"[LVA Event] json parse fallback to raw ({e})", file=sys.stderr)
        text = raw
except Exception as e:
    print(f"[LVA Event] stdin error: {e}", file=sys.stderr)
    text = ""

payload = json.dumps({"event": "synthesize", "text": text})
print(f"[LVA Event] sending UDP: {payload}", file=sys.stderr)
sock = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
sock.sendto(payload.encode("utf-8"), ("127.0.0.1", {{ va_ui_udp_port }}))
'

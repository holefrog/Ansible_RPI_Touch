#!/bin/bash
# 触发监听界面的 UDP 包，使用 Python 避免 nc 命令的阻塞卡死
echo "[LVA Event] awake triggered" >&2
python3 -c '
import sys, socket
try:
    sys.stdin.readline()
except Exception as e:
    print(f"[LVA Event] 读取 stdin 失败: {e}", file=sys.stderr)
socket.socket(socket.AF_INET, socket.SOCK_DGRAM).sendto(b"{\"event\": \"awake\"}", ("127.0.0.1", {{ va_ui_udp_port }}))
'

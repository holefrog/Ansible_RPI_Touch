# ansible/roles/voiceassistant/templates/lva.env.j2
# v1
# LVA 通过环境变量控制所有行为，由 docker-entrypoint.sh 读取

# ── Home Assistant 连接 ──────────────────────────────────────────────
# HA 的本地 IP（非 Tailscale 地址，LVA 通过 ESPHome API 直连 LAN）
HA_HOST=192.168.50.236
HA_PORT=8123
# HA 长期访问令牌（在 HA 用户配置文件页生成后填入）
HA_TOKEN={{ lva_ha_token }}

# ── 唤醒词 ──────────────────────────────────────────────────────────
WAKEWORD={{ lva_wake_word }}

# ── 音频：PipeWire/Pulse socket ──────────────────────────────────────
# 让 LVA 容器内（或裸机进程）找到用户级 PulseAudio/PipeWire socket
PULSE_SERVER=unix:{{ va_user_runtime_dir }}/pulse/native
XDG_RUNTIME_DIR={{ va_user_runtime_dir }}

# ── 事件回调脚本（通知 TouchScreen UI）────────────────────────────────
# LVA 在对应阶段会调用这些脚本，与原 wyoming event scripts 逻辑相同
LVA_ON_WAKE_WORD={{ lva_repo_dest }}/event_scripts/awake.sh
LVA_ON_STT_END={{ lva_repo_dest }}/event_scripts/transcript.sh
LVA_ON_TTS_START={{ lva_repo_dest }}/event_scripts/tts-start.sh
LVA_ON_TTS_END={{ lva_repo_dest }}/event_scripts/done.sh
LVA_ON_SYNTHESIZE={{ lva_repo_dest }}/event_scripts/synthesize.sh

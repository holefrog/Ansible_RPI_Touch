[Unit]
Description=Touchscreen 显示服务

[Service]
Environment="XDG_RUNTIME_DIR={{ user_runtime_dir }}"
Type=simple
WorkingDirectory={{ ts_app_dir }}

ExecStart={{ ts_venv_dir }}/bin/python {{ ts_app_dir }}/main.py
Restart=always
RestartSec=15
StandardOutput=journal
StandardError=journal
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=default.target
